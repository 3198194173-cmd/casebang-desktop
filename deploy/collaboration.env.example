# Copy this file to deploy/collaboration.env on the server.
# This file contains identifiers only. Never put a client secret or database password here.
PUBLIC_ORIGIN=https://casebang.tech/collab
DB_SSL=false

# Keep disabled for the first database/API smoke test. Enable after the DingTalk
# secret has been rotated, placed in deploy/secrets, and event subscriptions are ready.
DINGTALK_STREAM_ENABLED=false
DINGTALK_CORP_ID=replace-with-corp-id
DINGTALK_CLIENT_ID=replace-with-client-id
DINGTALK_AGENT_ID=replace-with-agent-id

# WPS WebOffice stays disabled until every callback passes the console debugger.
WPS_WEBOFFICE_ENABLED=false
WPS_APP_ID=SX20260918QZNBYG
