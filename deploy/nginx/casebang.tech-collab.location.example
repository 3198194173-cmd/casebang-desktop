# Include this file inside the existing HTTPS `server` block for casebang.tech.
# The trailing slash on proxy_pass intentionally removes /collab/ before the
# request reaches the private API.
location = /collab {
    return 308 /collab/;
}

location /collab/ {
    client_max_body_size 70m;

    proxy_pass http://127.0.0.1:3100/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /collab;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 120s;
}
